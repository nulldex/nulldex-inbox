# Copied to /etc/nulldex-admin.env on first setup (chmod 600). Never commit the real file.
PORT=3001
DATA_DIR=/var/lib/nulldex-admin

# where the admin UI lives, and which public site may post to /api/contact
ADMIN_HOST=admin.example.com
SITE_HOSTS=example.com,www.example.com

# shared secret between the Cloudflare Email Worker and this server (generated automatically)
INBOUND_SECRET=

# Brevo API key (restricted: "Transactional email" only). Leave empty to disable sending.
BREVO_API_KEY=

MAIL_FROM=hello@example.com
MAIL_FROM_NAME=Inbox
